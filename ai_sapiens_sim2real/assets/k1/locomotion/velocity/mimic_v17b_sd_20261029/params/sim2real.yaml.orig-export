deployment_metadata:
  source: walk_stable_amp_1 (checkpoints/walk_stable_amp_1) + mimic student v17b
  input_layout: term-major history (walk part); walk policy internally permutes to
    time-major
  history_length: 5
  single_frame_dim: 78
  observation_dim: 539
  action_dim: 23
  normalization: none in the ONNX; the walk obs scales are in observations.*.scale
  raw_action_limit: 10.0
